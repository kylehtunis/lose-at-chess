{
  "name": "lose-at-chess",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w packages/client",
    "check": "npm run check --workspaces --if-present",
    "test": "npm test -w packages/worker",
    "deploy": "npm run build && npm run deploy -w packages/worker"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
